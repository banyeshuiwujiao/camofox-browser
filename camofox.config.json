{
  "id": "camofox-browser",
  "name": "Camofox Browser",
  "version": "1.6.0",
  "newPageTimeoutMs": 30000,
  "disableDefaultAddons": false,
  "interactive": { "mode": "desktop" },
  "workarounds": { "disableContentSandbox": true },
  "plugins": {
    "youtube": { "enabled": true },
    "persistence": { "enabled": true },
    "login-guard": { "enabled": true },
    "vnc": { "enabled": false, "resolution": "1920x1080" }
  }
}
